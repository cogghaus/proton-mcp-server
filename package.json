{
  "name": "proton-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Proton Mail via Proton Bridge",
  "author": "Adam Coggins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cogghaus/proton-mcp-server.git"
  },
  "homepage": "https://github.com/cogghaus/proton-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cogghaus/proton-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proton",
    "protonmail",
    "email",
    "imap",
    "smtp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --outDir dist --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
